clc; clear; close all;

% --- GPU CHECK ---
if gpuDeviceCount == 0
    error('No GPU detected. This code requires a GPU and the Parallel Computing Toolbox.');
else
    d = gpuDevice;
    fprintf('Running on GPU: %s\n', d.Name);
end

% --- 1. Simulation Parameters ---
X = 100; Y = 100;           % Map dimensions (meters)
std_mag_noise = 0.5;        % Magnetic noise (uT)
Fs = 100;                   % Sampling Rate 100Hz

% Drift Parameters
gyro_bias = 0.02;           % Gyro Bias (rad/s) - Causes heading drift
sigma_gyro = 0.005;         % Gyro White Noise
sigma_acc = 0.1;            % Accel Noise

% Step Length Parameters (Constant Assumption)
fixed_step_model = 1.5;     % The PDR assumes every step is 1.5m
sigma_step_est = 0.01;       % Uncertainty/Noise in PDR step estimation

% --- 2. Generate Magnetic Map (GPU-Ready) ---
fprintf('Generating Magnetic Map...\n');
baseMap = Geometric_Map_Generator(2, [X, Y]);

% Create high-res grid for interpolation
[xx, yy] = meshgrid(1:X, 1:Y);
[xi, yi] = meshgrid(linspace(1, X, 200), linspace(1, Y, 200));
baseMap_smooth = interp2(xx, yy, baseMap, xi, yi, 'cubic');

% Pre-calculate grid vectors
grid_x = linspace(1, X, size(baseMap_smooth, 2));
grid_y = linspace(1, Y, size(baseMap_smooth, 1));

% Move static map data to GPU memory once
g_map = gpuArray(single(baseMap_smooth)); 
g_grid_x = gpuArray(single(grid_x));
g_grid_y = gpuArray(single(grid_y));

% Visualization Setup
figure(1);
imagesc(grid_x, grid_y, baseMap_smooth);
colormap(parula); shading interp; colorbar;
set(gca, 'YDir', 'normal'); hold on;
title('FGLC Simulation: Constant Step Length + Warm Start');
xlabel('X (m)'); ylabel('Y (m)');

h_true = plot(NaN, NaN, 'k-', 'LineWidth', 2, 'DisplayName', 'Ground Truth');
h_pdr = plot(NaN, NaN, 'g--', 'LineWidth', 1.5, 'DisplayName', 'PDR (Drifting)');
h_est = plot(NaN, NaN, 'r.-', 'LineWidth', 2, 'DisplayName', 'FGLC (Corrected)');
legend show;

% --- 3. Initialization ---
init_pos = [25, 25]; 
true_pos = init_pos;
true_heading = 0;   
true_path = true_pos;

pdr_pos = init_pos; 
pdr_path = pdr_pos;
pdr_heading = 0;    

% Data Containers
store_steps = [];
store_dangles = [];
store_mags = [];

% Warm Start Variables
last_w = [];
last_v = [];

% --- 4. Main Loop ---
total_steps = 100; 
hWait = waitbar(0, 'Simulating on GPU...');

for i = 1:total_steps
    %% A. Ground Truth Generation (Actual Walking)
    % The user actually walks with slight variation (1.5 +/- 0.05)
    real_step_len = 1.5 + 0.05*randn(); 
    real_turn = 0.2 * randn(); 
    
    true_heading = true_heading + real_turn;
    
    % Wall Collision Check
    test_pos = true_pos + real_step_len * [cos(true_heading), sin(true_heading)];
    if test_pos(1)<2 || test_pos(1)>X-2 || test_pos(2)<2 || test_pos(2)>Y-2
        true_heading = true_heading + pi; 
        real_turn = real_turn + pi;
    end
    
    true_pos = true_pos + real_step_len * [cos(true_heading), sin(true_heading)];
    true_path = [true_path; true_pos];
    
    %% B. IMU Simulation
    step_duration = 0.6; 
    [raw_acc, raw_gyro] = simulate_imu_data(real_step_len, real_turn, step_duration, Fs, gyro_bias, sigma_acc, sigma_gyro);
    
    %% C. PDR Calculation (Constant Step Assumption)
    % We pass the 'fixed_step_model' (1.5) to the PDR
    [base_step, meas_dangle] = run_simple_pdr(raw_acc, raw_gyro, Fs, fixed_step_model);
    
    % Add estimation noise (simulating that PDR isn't perfect)
    meas_step = base_step + sigma_step_est * randn();
    
    % Update PDR Path
    pdr_heading = pdr_heading + meas_dangle;
    pdr_pos = pdr_pos + meas_step * [cos(pdr_heading), sin(pdr_heading)];
    pdr_path = [pdr_path; pdr_pos];
    
    store_steps = [store_steps; meas_step];
    store_dangles = [store_dangles; meas_dangle];
    
    %% D. Magnetic Measurement
    true_mag_val = interp2(grid_x, grid_y, baseMap_smooth, true_pos(1), true_pos(2), 'cubic', 0);
    meas_mag = true_mag_val + std_mag_noise * randn();
    store_mags = [store_mags; meas_mag];
    
    %% E. FGLC Optimization (GPU + Warm Start)
    [est_traj_gpu, last_w, last_v] = mainalgr_gpu(init_pos, store_steps, store_dangles, store_mags, ...
                                             g_map, g_grid_x, g_grid_y, last_w, last_v);
    
    est_traj = gather(est_traj_gpu);
    
    % Update Plot
    set(h_true, 'XData', true_path(:,1), 'YData', true_path(:,2));
    set(h_pdr, 'XData', pdr_path(:,1), 'YData', pdr_path(:,2));
    set(h_est, 'XData', est_traj(:,1), 'YData', est_traj(:,2));
    drawnow limitrate;
    
    waitbar(i/total_steps, hWait);
end
close(hWait);
fprintf('Simulation Complete.\n');

%% --- GPU Optimized Algorithm ---
function [est_traj, w_out, v_out] = mainalgr_gpu(start_pos, steps, angles, mags, g_map, g_x, g_y, w_init, v_init)
    N = length(steps);
    
    % Constraints
    d_step = gpuArray(single(3 * 0.4)); 
    d_theta = gpuArray(single(3 * 0.3)); % Slightly relaxed heading constraint
    
    % Move inputs to GPU
    steps_g = gpuArray(single(steps));
    angles_g = gpuArray(single(angles));
    mags_g = gpuArray(single(mags));
    
    lr = 0.05; 
    iter_max = 100; 
    
    % Warm Start Initialization
    if isempty(w_init)
        w = zeros(N, 1, 'single', 'gpuArray');
        v = zeros(N, 1, 'single', 'gpuArray');
    else
        w = [w_init; 0];
        v = [v_init; 0];
    end
    
    m_w = zeros(size(w), 'single', 'gpuArray'); v_w = m_w;
    m_v = zeros(size(v), 'single', 'gpuArray'); v_v = m_v;
    
    beta1 = 0.9; beta2 = 0.999; eps_val = 1e-8;
    
    sp_x = gpuArray(single(start_pos(1)));
    sp_y = gpuArray(single(start_pos(2)));
    
    for iter = 1:iter_max
        % Variable Mapping
        step_adj = (2/pi) * d_step * atan(w);
        theta_adj = (2/pi) * d_theta * atan(v);
        
        curr_steps = steps_g + step_adj;
        curr_theta = cumsum(angles_g + theta_adj);
        
        % Path Reconstruction
        px = sp_x + cumsum(curr_steps .* cos(curr_theta));
        py = sp_y + cumsum(curr_steps .* sin(curr_theta));
        
        % Map Gradients
        d = 0.5;
        % Ensure column vectors for interp2
        qx = px(:); qy = py(:);
        
        mag_vals = interp2(g_x, g_y, g_map, qx, qy, 'linear', 0);
        
        mx_p = interp2(g_x, g_y, g_map, qx+d, qy, 'linear', 0);
        mx_m = interp2(g_x, g_y, g_map, qx-d, qy, 'linear', 0);
        dm_dx = (mx_p - mx_m) / (2*d);
        
        my_p = interp2(g_x, g_y, g_map, qx, qy+d, 'linear', 0);
        my_m = interp2(g_x, g_y, g_map, qx, qy-d, 'linear', 0);
        dm_dy = (my_p - my_m) / (2*d);
        
        residual = 2 * (mag_vals - mags_g);
        
        % Backpropagation
        grad_w = zeros(N, 1, 'single', 'gpuArray');
        grad_v = zeros(N, 1, 'single', 'gpuArray');
        
        term_x = residual .* dm_dx;
        term_y = residual .* dm_dy;
        
        for k = 1:N
            % Step Gradient
            grad_w(k) = sum(term_x(k:end)) * cos(curr_theta(k)) + ...
                        sum(term_y(k:end)) * sin(curr_theta(k));
            
            % Heading Gradient
            if k == 1
                pk_x = sp_x; pk_y = sp_y;
            else
                pk_x = px(k-1); pk_y = py(k-1);
            end
            
            rx = px(k:end) - pk_x;
            ry = py(k:end) - pk_y;
            
            grad_v(k) = sum(term_x(k:end) .* (-ry) + term_y(k:end) .* (rx));
        end
        
        % Constants & Update
        dw_const = (2/pi) * d_step ./ (1 + w.^2);
        dv_const = (2/pi) * d_theta ./ (1 + v.^2);
        
        grad_w = grad_w .* dw_const;
        grad_v = grad_v .* dv_const;
        
        m_w = beta1 * m_w + (1-beta1) * grad_w;
        v_w = beta2 * v_w + (1-beta2) * grad_w.^2;
        w = w - lr * m_w ./ (sqrt(v_w) + eps_val);
        
        m_v = beta1 * m_v + (1-beta1) * grad_v;
        v_v = beta2 * v_v + (1-beta2) * grad_v.^2;
        v = v - lr * m_v ./ (sqrt(v_v) + eps_val);
    end
    
    est_traj = [ [sp_x, sp_y]; px, py ];
    w_out = w;
    v_out = v;
end

%% --- Helper 1: IMU Generator ---
function [acc, gyro] = simulate_imu_data(step_len, turn_angle, duration, Fs, bias, n_acc, n_gyro)
    N = round(duration * Fs);
    t = linspace(0, duration, N)';
    
    % Accel: Sine wave + Gravity
    amp = step_len * 2.0; 
    acc_signal = amp * sin(2*pi * (1/duration) * t); 
    acc = acc_signal + 9.8 + n_acc * randn(N, 1);
    
    % Gyro: Rate + Bias + Noise
    true_rate = turn_angle / duration;
    gyro = repmat(true_rate, N, 1) + bias + n_gyro * randn(N, 1);
end

%% --- Helper 2: Simple PDR (Fixed Step) ---
function [step_length, delta_heading] = run_simple_pdr(~, gyro, Fs, fixed_len)
    % 1. Heading Integration
    dt = 1/Fs;
    delta_heading = sum(gyro) * dt;
    
    % 2. Constant Step Length Assumption
    % Ignores accelerometer data for length estimation
    step_length = fixed_len; 
end

%% --- Helper 3: Tuned Map Generator ---
function map = Geometric_Map_Generator(~, size_arr)
    % Create a map with sharper peaks (higher frequency and amplitude)
    % to ensure the optimizer has strong gradients to follow.
    [xx, yy] = meshgrid(linspace(-3,3,size_arr(1)), linspace(-3,3,size_arr(2)));
    
    % Increased multipliers for sharper gradients
    raw_peaks = 3*(1-xx).^2.*exp(-(xx.^2) - (yy+1).^2) ...
              - 10*(xx/5 - xx.^3 - yy.^5).*exp(-xx.^2 - yy.^2) ...
              - 1/3*exp(-(xx+1).^2 - yy.^2);
              
    % Scale to uT range: Base 40uT + Variation
    map = 40 + 20 * raw_peaks; 
end